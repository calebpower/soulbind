{
    "name": "soulbind/flarum-connector",
    "description": "Cross-platform account linking for Flarum",
    "type": "flarum-extension",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "flarum/core": "^1.8.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Soulbind\\Flarum\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Soulbind\\Flarum\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "soulbind",
            "category": "feature"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-hostile": "phpunit --configuration phpunit-hostile.xml"
    },
    "config": {
        "allow-plugins": {
            "flarum/extension-manager-composer-plugin": false
        }
    }
}
