# Pinned images for the forum tier.
#
# DIGESTS, never tags, for the reason stated in .reaper.toml: a tag is a mutable
# pointer, and a stack whose forum, database or browser silently changed
# underneath a test is a stack whose green result means nothing.
#
# Re-pinning is a deliberate act with a dated note here, never a side effect of
# somebody re-running the script on a Tuesday.

# php 8.3-cli, resolved 2026-08-16.
#
# 8.3 and NOT 8.4, which is what the rest of this repository's PHP runs on. The
# reason is Flarum 1.8's dependency tree: illuminate/support emits
# "Implicitly marking parameter $callback as nullable is deprecated" on 8.4,
# twice, on every single request. The extension's own suite passes on 8.4 --
# that is asserted separately, in the PHPUnit step, and stays on 8.4 on purpose
# -- but a forum whose every page load carries two deprecation notices is not a
# forum a browser tier should be reading output from.
#
# This is a real difference from the workstation and worth stating: the unit
# suite runs on 8.4, the forum runs on 8.3, and if that ever diverges in a way
# that matters, the unit suite is the one telling the truth about the extension.
FLARUM_PHP_IMAGE=docker.io/library/php@sha256:f62df9916bc05ae3c5120b41a115938f22623b0c98c815cbe2c67bc73cec21ef

# mariadb 11.4 LTS, resolved 2026-08-15. The SAME digest the storage tier uses,
# deliberately: two database versions in one repository is two sets of
# behaviour to reason about, and nothing here needs a different one.
FLARUM_DB_IMAGE=docker.io/library/mariadb@sha256:67873d30a17f6a9c331f06363b2fa15f38abca415529966d67c84f87f82439fe

# Playwright v1.50.0 on Ubuntu Noble, resolved 2026-08-16.
#
# Microsoft's image rather than installing browsers into a bare Node container:
# the browser build and the driver that steers it are versioned together, and
# mismatching them produces failures that look like the site under test is
# broken.
FLARUM_BROWSER_IMAGE=mcr.microsoft.com/playwright@sha256:f87ec3ea2f3a394e050d0a5f1f83052b52b17fb70836e0bf29b5afb31fb58ce4

# Flarum itself. A version, not a digest -- it arrives through composer, which
# pins by lock file rather than by image.
#
# 1.8.19 and not 2.x: 2.x exists only as v2.0.0-rc.5, and pinning a release
# candidate for an extension people install on a live forum trades their
# stability for our novelty.
FLARUM_VERSION=1.8.19

# composer 2.10, resolved 2026-08-16. The SAME digest .reaper.toml uses for the
# PHPUnit step: one composer in this repository, not two that can drift.
#
# Its own image rather than an installer script fetched at run time --
# downloading and executing an unverified bootstrap inside a test harness is the
# supply-chain shortcut a pinned digest exists to avoid.
COMPOSER_IMAGE=docker.io/library/composer@sha256:4d71c3c2109c61d5415544264b59ad4087e4c5b7244481723664138fd36d5040
