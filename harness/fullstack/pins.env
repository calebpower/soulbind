# Pinned artefacts for the local stack.
#
# CHECKSUMS, not just URLs. A URL is a promise somebody else keeps; a checksum
# is one this repository keeps. A stack that silently changed proxy build
# underneath a test is a stack whose green result means nothing -- the same
# reasoning that digest-pins the container images in .reaper.toml.
#
# Re-pinning is a deliberate act with a dated note here, never a side effect of
# somebody re-running the script on a Tuesday.

# Velocity 3.5.1 build 615, RECOMMENDED channel. Resolved 2026-08-16.
# Matches the velocity-api version connector-velocity compiles against, which
# is the point -- a plugin compiled against one API and run on another fails at
# load time, far from its cause.
VELOCITY_VERSION=3.5.1
VELOCITY_BUILD=615
VELOCITY_URL=https://fill-data.papermc.io/v1/objects/b4e3164df5377346854dc6cb9e6a78022b1946ff69e89676313f5f6f1c6f0fb3/velocity-3.5.1-615.jar
VELOCITY_SHA256=b4e3164df5377346854dc6cb9e6a78022b1946ff69e89676313f5f6f1c6f0fb3

# Paper 1.21.11 build 132, STABLE channel. Resolved 2026-08-16.
#
# NOT the newest Paper. The ceiling is the harness client: mineflayer 4.37.1
# speaks up to 26.1, and 26.2 was refused outright with "Server version '26.2'
# is not supported".
#
# That costs less than it looks like. The plugin under test runs on the PROXY
# and never talks to Paper -- the backend exists so a player has somewhere to be
# sent after the gate admits them. Velocity, which is what the plugin loads
# into, is pinned at the version its API was compiled against.
#
# Worth re-pinning upward whenever mineflayer catches up, because "the backend
# is old" is a difference from production even when it is not a load-bearing
# one.
PAPER_VERSION=1.21.11
PAPER_BUILD=132
PAPER_URL=https://fill-data.papermc.io/v1/objects/5ffef465eeeb5f2a3c23a24419d97c51afd7dbb4923ff42df9a3f58bba1ccfba/paper-1.21.11-132.jar
PAPER_SHA256=5ffef465eeeb5f2a3c23a24419d97c51afd7dbb4923ff42df9a3f58bba1ccfba

# The protocol version the harness client speaks.
#
# Stated rather than autodetected, and set to the BACKEND's version rather than
# the proxy's. Velocity advertises its own newest protocol (26.1.2 at 3.5.1),
# and the installed mineflayer's data tops out at 1.21.11 -- autodetection then
# refuses the connection before anything under test runs.
#
# A proxy accepts a range of client versions, so a 1.21.11 client is a
# legitimate one; it is simply an older client than the proxy's newest. That is
# a real difference from a production player on the latest build, and it is the
# reason this line sits beside the jar pins: whichever moves, the others have to
# be checked.
MC_PROTOCOL=1.21.11

# --- toolchains -------------------------------------------------------------
#
# The JDK and Node the stack RUNS on, pinned by checksum like every other
# artefact here.
#
# Why this exists at all: the Linux guest ships "ZFS, podman, rsync, guest
# agent. No language toolchains." That was treated for a while as a wall
# requiring the whole game tier to be containerised. It is not. fetch.sh already
# fetches checksum-pinned artefacts and was written from the start to run on the
# workstation AND in the guest -- so a JDK and a Node are simply two more pinned
# artefacts, and one stack.sh runs in both places.
#
# NOT `apt-get install openjdk`. An unpinned toolchain is exactly what the header
# of this file argues against: a stack that silently changed underneath a test is
# a stack whose green result means nothing. A JDK is more load-bearing than a
# proxy jar, not less.
#
# PLATFORM ASYMMETRY, stated. These are linux-x64 tarballs, and they are fetched
# only on Linux. Neither Temurin nor nodejs.org publishes a FreeBSD build, so the
# workstation uses its own toolchains -- which is why stack.sh asserts a MINIMUM
# version there rather than assuming a pin. The guest, where reproducibility
# actually matters because nobody is watching, gets the pinned bytes.

# Temurin JDK 25.0.4+7, linux x64. Resolved 2026-08-16 via the Adoptium API.
# 25 because core targets 25; Paper's floor is 21 and it runs happily on 25.
JDK_VERSION=25.0.4+7
JDK_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4%2B7/OpenJDK25U-jdk_x64_linux_hotspot_25.0.4_7.tar.gz
JDK_SHA256=e58fcdcd637b25c03ca84cbbcefc70d11efb8f4b4cbd05decc9f661769d77f94

# Node 24.19.0 LTS, linux x64. Resolved 2026-08-16 from nodejs.org/dist.
# LTS rather than current: the player driver is mineflayer, and a harness client
# chasing Node's release train is a harness that breaks for reasons that have
# nothing to do with what it tests.
NODE_VERSION=24.19.0
NODE_URL=https://nodejs.org/dist/v24.19.0/node-v24.19.0-linux-x64.tar.xz
NODE_SHA256=14b342e71204f811bde6153be8e04b62aef63c236fef92b55f9c83154b409647

# Plan 5.8 build 3605, the plugin. Resolved 2026-08-17 from the project's
# GitHub releases.
#
# The SAME build as the API connector-plan compiles against
# (com.github.plan-player-analytics:Plan:5.8.3605 in that module's build file).
# That is not a coincidence to preserve by luck: Plan's extension API is
# annotation-driven, and a provider signature that stops matching produces a
# page with a missing panel and no error anywhere. Compiling against one build
# and running against another is how that happens quietly, so the two move
# together or not at all.
PLAN_VERSION=5.8.3605
PLAN_URL=https://github.com/plan-player-analytics/Plan/releases/download/5.8.3605/Plan-5.8-build-3605.jar
PLAN_SHA256=f61cb806910dd7d2aceb2a37d53eb5ec4c6045f8a7531206fe731ec0ef9a105c

# Plan's MySQL driver, pre-seeded so a stack-up needs no network.
#
# Plan fetches these itself at every startup through dev.vankka's
# dependency-downloader, into plugins/plan/libraries. It DOES verify them --
# assets/plan/dependencies/mysqlDriver.txt inside the Plan jar carries the same
# two SHA-256 values pinned below, and the bytes fetched from Maven Central match
# them exactly. So this is not an unverified download; it is a verified one this
# repository does not control and cannot reproduce offline.
#
# Pinned here for two reasons. A stack-up that reaches the internet on every run
# fails when the network does, for a reason unrelated to anything under test.
# And a harness whose whole discipline is "the bytes are pinned or the green
# means nothing" should not have one component quietly exempt because somebody
# else did the pinning.
#
# The checksums were taken from Maven Central and cross-checked against Plan's
# own manifest -- two independent statements of the same value, which is a
# better guarantee than either alone. Re-pin when the Plan pin moves: these
# versions come from the Plan build, not from us.
PLAN_MYSQL_DRIVER_VERSION=9.7.0
PLAN_MYSQL_DRIVER_URL=https://repo1.maven.org/maven2/com/mysql/mysql-connector-j/9.7.0/mysql-connector-j-9.7.0.jar
PLAN_MYSQL_DRIVER_SHA256=0353648eaa1c91e0f4020c959abf756bc866ffd583df22ae6b6f6e0cbd43eb44

PLAN_PROTOBUF_VERSION=4.31.1
PLAN_PROTOBUF_URL=https://repo1.maven.org/maven2/com/google/protobuf/protobuf-java/4.31.1/protobuf-java-4.31.1.jar
PLAN_PROTOBUF_SHA256=d60dfe7c68a0d38a248cca96924f289dc7e1966a887ee7cae397701af08575ae
