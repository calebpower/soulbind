# Pinned artefacts for the PHP mutation tier.
#
# CHECKSUMS, not just URLs, for the reason harness/fullstack/pins.env states: a
# URL is a promise somebody else keeps; a checksum is one this repository keeps.
#
# Re-pinning is a deliberate act with a dated note here, never a side effect of
# somebody re-running the script on a Tuesday.

# Infection 0.35.2, resolved 2026-08-20.
#
# The PHAR, and NOT `composer require --dev infection/infection`, which does not
# resolve: Flarum 1.8 locks psr/log to 1.x and Infection 0.35 requires ^2 || ^3.
# There is no version pair that satisfies both, so the tool cannot live in the
# extension's dependency tree at all. That is not a defect in either package --
# a mutation runner has no business sharing a lock with the code it mutates, and
# the PHAR is how Infection ships for exactly this case.
#
# A pinned PHAR is also strictly better here than a composer dependency: one
# checksum instead of a hundred transitive packages resolved fresh.
INFECTION_VERSION=0.35.2
INFECTION_URL=https://github.com/infection/infection/releases/download/0.35.2/infection.phar
INFECTION_SHA256=0e146c52570b8e394e981635eaf61643f9ce4f35d83e4286ba3d965524631cc3

# pcov 1.0.12, resolved 2026-08-20.
#
# A COVERAGE DRIVER IS NOT OPTIONAL. Infection needs line coverage to know which
# tests cover the line it just mutated; without one it cannot start. php-code-
# coverage 11 (what PHPUnit 11 uses) accepts pcov or Xdebug and nothing else --
# phpdbg support was removed in version 10.
#
# pcov rather than Xdebug: it does line coverage and nothing else, at a fraction
# of Xdebug's overhead, and Infection re-runs the suite once per mutant.
#
# Pinned to an exact release rather than `pecl install pcov`, which takes
# whatever is newest on the day. A version pin, not a checksum -- PECL does not
# publish per-file digests in a form this can verify offline, and that is a
# weaker guarantee than the rest of this file. Stated rather than glossed.
PCOV_VERSION=1.0.12
