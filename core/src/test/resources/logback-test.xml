<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test logging.

  WARN by default. The fuzz task turns on showStandardStreams so its SEED line
  is visible -- and at DEBUG the connection pool's configuration dump buries
  that line under two hundred others, which defeats the only reason the streams
  were turned on.

  This raises the floor for third-party libraries, not for soulbind: a warning
  or an error from anything still prints, and a test failure is reported by the
  test framework regardless of log level. Nothing is silenced to make a failure
  go away.
-->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} -- %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="com.zaxxer.hikari" level="WARN"/>
  <logger name="org.flywaydb" level="WARN"/>
  <logger name="io.javalin" level="WARN"/>
  <logger name="org.eclipse.jetty" level="WARN"/>

  <!-- soulbind's own logging stays at INFO: if core says something during a
       test, that is worth seeing. -->
  <logger name="dev.soulbind" level="INFO"/>

  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
