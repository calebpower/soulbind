# Build output
/build/
**/build/
/.gradle/
/build-logic/.gradle/
/build-logic/build/

# Dependencies
/node_modules/
**/node_modules/
/vendor/
**/vendor/

# Test and harness output. Results land here from a reaper session; they are
# artifacts of a run, never inputs to one.
/out/

# Fetched stack artefacts. Pinned by checksum in harness/fullstack/pins.env,
# so the pin is committed and the bytes are not -- a 100MB jar in git is a jar
# somebody clones every time to run one test.
/harness/fullstack/.cache/
# A GLOB again, and for the same reason the pins.env line below records: the
# runner creates run-sqlite/ and run-mariadb/, one per storage axis, and a rule
# naming `run/` covers the instance rather than the class. Caught by `git status`
# showing 182 MB of generated Paper world as untracked-and-committable, one
# `git add -A` from the repository.
/harness/fullstack/run/
/harness/fullstack/run-*/

# Local tooling state
.DS_Store
*.swp
.idea/
*.iml
.vscode/

# Secrets never belong in the tree. Config carries environment-variable
# overrides for exactly this reason.
*.env

# ...except the pinned artefact lists, which are the OPPOSITE of a secret: they
# are the record of exactly which bytes a stack run used, and a clone without
# them cannot reproduce anything. Caught because *.env silently swallowed one.
#
# A GLOB, not a list. The first version named harness/fullstack/pins.env
# specifically, and the next harness added -- harness/flarum -- was silently
# swallowed in exactly the same way, by exactly the same line, because the fix
# had been written to cover the instance rather than the class.
#
# HarnessPinsGuardTest asserts every pins.env on disk is actually tracked, so
# the next one cannot go missing quietly either.
!harness/*/pins.env

/secrets/
