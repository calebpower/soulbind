# Secrets for soulbind core. Install to /etc/soulbind/core.env, mode 0600,
# owned root:soulbind, and referenced by EnvironmentFile= in the systemd unit.
#
# Copyright (c) 2026 Caleb L. Power. Apache-2.0; see LICENSE.
#
# These live here rather than in soulbind.toml so that the configuration file
# can be read, copied and attached to a bug report without leaking anything.
#
# Every config key has an environment name: `a.b.c` becomes SOULBIND_A_B_C, and
# nothing else can produce that name. The environment wins over the file.

# Required for MariaDB. Unused, and may be omitted, for SQLite.
SOULBIND_STORAGE_PASSWORD=change-me
