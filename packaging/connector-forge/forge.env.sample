# Secrets for the soulbind forge connector. Install to /etc/soulbind/forge.env,
# mode 0600, owned root:soulbind.
#
# Copyright (c) 2026 Caleb L. Power. Apache-2.0; see LICENSE.

# The forge's administrative token. The key is host.token, so the environment
# name is SOULBIND_HOST_TOKEN -- `a.b` becomes SOULBIND_A_B and nothing else can
# produce that name.
#
# This token can create and deactivate ANY account on the forge. Scope it as
# narrowly as the host allows, and keep it here rather than in the toml.
SOULBIND_HOST_TOKEN=change-me

# The credential core printed when this connector was registered:
#
#   soulbind register --name forge \
#       --capabilities code-entry,enforcement-point,link-state-reader,effector
#
# Core keeps only the hash and prints the plaintext ONCE. If it is lost or
# leaked, rotate it -- `connector.rotate` replaces it immediately, with no
# overlap window, and the old one stops working on the next request.
SOULBIND_CORE_CREDENTIAL=change-me
