# Secrets for the soulbind Discord connector. Install to
# /etc/soulbind/discord.env, mode 0600, owned root:soulbind.
#
# Copyright (c) 2026 Caleb L. Power. Apache-2.0; see LICENSE.

# The bot token, from the developer portal. The key is platform.token, so the
# environment name is SOULBIND_PLATFORM_TOKEN -- `a.b` becomes SOULBIND_A_B and
# nothing else can produce that name. A bot token in a file
# somebody pastes into an issue is a bot somebody else controls.
SOULBIND_PLATFORM_TOKEN=change-me

# The credential core printed when this connector was registered:
#
#   soulbind register --name discord \
#       --capabilities code-display,code-entry,effector
#
# Core keeps only the hash and prints the plaintext ONCE. If it is lost, or
# leaked, rotate it -- `connector.rotate` replaces it immediately, with no
# overlap window, and the old one stops working on the next request.
SOULBIND_CORE_CREDENTIAL=change-me
